# butera_burster: persistent-sodium bursting pacemaker neuron of the preBoetzinger complex.
#
# Butera RJ, Rinzel J, Smith JC (1999) "Models of respiratory rhythm generation in the pre-Boetzinger complex.
# I. Bursting pacemaker neurons", J Neurophysiol 82:382-397, model 1 (I_NaP, I_Na, I_K, I_L, I_tonic-e),
# with the paper's parameters (C = 21 pF, g_NaP = 2.8 nS, g_Na = 28 nS, g_K = 11.2 nS, g_L = 2.8 nS,
# E_L = -65 mV, tau_h,max = 10 s). Burst termination is slow inactivation of I_NaP (h);
# the conductance g_tonic (paper's g_tonic-e, E = 0 mV) sets the excitatory drive and with it burst
# frequency (quiescent -> bursting -> tonic spiking as drive grows).
#
#   C dV/dt = -I_NaP - I_Na - I_K - I_L - I_tonic - I_syn - I_ne - I_ach + I_e + I_stim
#
# Output: one spike per action potential (upward crossing of V_th = -10 mV, re-armed below V_rearm);
# bursts are the clusters of these spikes (docs/models/butera_burster.md).
# ne / ach (dimensionless 0..1): phenomenological excitatory drive channels, g = g_ne * ne and g_ach * ach
# (NE: alpha1 excitation of preBoetC; ACh: muscarinic depolarisation); see the doc.
model butera_burster:

    state:
        V_m mV = -60 mV
        n real = 0.            # I_K activation
        h_inact real = 0.6           # I_NaP inactivation
        armed boolean = true

    equations:
        inline m_inf real = 1. / (1. + exp((V_m - theta_m) / sigma_m))
        inline n_inf real = 1. / (1. + exp((V_m - theta_n) / sigma_n))
        inline mp_inf real = 1. / (1. + exp((V_m - theta_mp) / sigma_mp))
        inline h_inf real = 1. / (1. + exp((V_m - theta_h) / sigma_h))
        inline tau_n ms = tau_n_max / cosh((V_m - theta_n) / (2. * sigma_n))
        inline tau_h ms = tau_h_max / cosh((V_m - theta_h) / (2. * sigma_h))

        inline I_NaP pA = g_NaP * mp_inf * h_inact * (V_m - E_Na)
        inline I_Na pA = g_Na * m_inf**3 * (1. - n) * (V_m - E_Na)
        inline I_K pA = g_K * n**4 * (V_m - E_K)
        inline I_L pA = g_L * (V_m - E_L)
        inline I_tonic pA = g_tonic * (V_m - E_tonic)
        inline I_mod pA = (g_ne * ne + g_ach * ach) * (V_m - E_tonic)

        kernel g_exc = exp(-t / tau_syn_exc)
        kernel g_inh = exp(-t / tau_syn_inh)
        inline I_syn pA = unit_psg * (convolve(g_exc, exc_spikes) * (V_m - E_exc) + convolve(g_inh, inh_spikes) * (V_m - E_inh))

        V_m' = (-I_NaP - I_Na - I_K - I_L - I_tonic - I_mod - I_syn + I_e + I_stim) / C_m
        n' = (n_inf - n) / tau_n
        h_inact' = (h_inf - h_inact) / tau_h

    parameters:
        C_m pF = 21 pF
        g_NaP nS = 2.8 nS
        g_Na nS = 28 nS
        g_K nS = 11.2 nS
        g_L nS = 2.8 nS
        E_Na mV = 50 mV
        E_K mV = -85 mV
        E_L mV = -65 mV
        theta_m mV = -34 mV
        sigma_m mV = -5 mV
        theta_n mV = -29 mV
        sigma_n mV = -4 mV
        theta_mp mV = -40 mV
        sigma_mp mV = -6 mV
        theta_h mV = -48 mV
        sigma_h mV = 6 mV
        tau_n_max ms = 10 ms
        tau_h_max ms = 10000 ms

        # drive
        g_tonic nS = 0.3 nS      # tonic excitatory conductance (paper g_tonic-e); 0.3 nS bursts at ~0.2 Hz
        E_tonic mV = 0 mV
        I_e pA = 0 pA

        # modulators (settable at runtime through set_status)
        ne real = 0.
        ach real = 0.
        g_ne nS = 0.3 nS         # excitatory conductance per unit ne
        g_ach nS = 0.1 nS        # excitatory conductance per unit ach

        # synapses
        E_exc mV = 0 mV
        E_inh mV = -75 mV
        tau_syn_exc ms = 5 ms
        tau_syn_inh ms = 10 ms

        # spike (action potential) detector
        V_th mV = -10 mV
        V_rearm mV = -30 mV

    internals:
        unit_psg nS = 1 nS

    input:
        exc_spikes <- excitatory spike
        inh_spikes <- inhibitory spike
        I_stim pA <- continuous

    output:
        spike

    update:
        integrate_odes()
        if armed and V_m > V_th:
            armed = false
            emit_spike()
        if not armed and V_m < V_rearm:
            armed = true
