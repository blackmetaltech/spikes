[configuration]
entry_symbol = "spike_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
linux.x86_64.debug = "res://bin/libspike_gd_debug.so"
linux.x86_64.release = "res://bin/libspike_gd_release.so"
; Windows x86_64: planned (MinGW cross-build or a Windows CI runner, see README "Windows"); the DLLs are not produced by scripts/ yet.
windows.x86_64.debug = "res://bin/spike_gd_debug.dll"
windows.x86_64.release = "res://bin/spike_gd_release.dll"

[dependencies]
; exported next to the library: the headless runner behind CHECK (the game looks beside the extension first)
linux.x86_64 = { "res://bin/spike-run": "" }
windows.x86_64 = { "res://bin/spike-run.exe": "" }
