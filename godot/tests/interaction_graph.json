{
 "schema": 1,
 "about": "The interaction graph of the game: every screen, modal, panel and toast as a node, every user action that moves between them as an edge. It is the source of truth for the UI and tests/ui_graph_test.gd walks it. See docs/INTERACTION-GRAPH.md.",
 "entry": "title",
 "layout": "desktop",
 "fixtures": {
  "$first": "the first level of the campaign (open from the start)",
  "$locked": "a level that is locked in a fresh save",
  "$dx": "the first diagnosis case"
 },
 "ignore": [
  {
   "under_class": "Stepper",
   "why": "The two arrow buttons of a stepper are part of the stepper, which is listed by its own id."
  },
  {
   "class": "HSlider",
   "under": "Inspector",
   "why": "Value sliders of the parameter rows: they edit a number, they do not navigate."
  },
  {
   "class": "LineEdit",
   "under": "Inspector",
   "why": "The number box beside each value slider."
  },
  {
   "class": "HSlider",
   "under_class": "ModDials",
   "why": "Read-only neuromodulator gauges drawn as sliders."
  },
  {
   "under_class": "FileDialog",
   "why": "The built-in widgets of Godot's FileDialog; the dialog itself is the node lab.filedlg."
  }
 ],
