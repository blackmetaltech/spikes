diff --git a/nestkernel/mpi_manager.h b/nestkernel/mpi_manager.h
index 56c752b..cd9d7ec 100644
--- a/nestkernel/mpi_manager.h
+++ b/nestkernel/mpi_manager.h
@@ -28,6 +28,10 @@
 
 // C includes:
 #include <unistd.h>
+#ifdef _WIN32
+// gethostname() lives in Winsock (needs WSAStartup); the computer name is all we want. Declared by hand so that <windows.h> does not enter every NEST file.
+extern "C" __declspec( dllimport ) int __stdcall GetComputerNameA( char*, unsigned long* );
+#endif
 #ifdef HAVE_MPI
 #include <mpi.h>
 #endif
@@ -143,6 +147,12 @@ public:
   void communicate( std::vector< unsigned long >& send_buffer,
     std::vector< unsigned long >& recv_buffer,
     std::vector< int >& displacements );
+#ifdef _WIN32
+  // size_t is `unsigned long long` here, not `unsigned long`: the non-MPI copy overload for it (SPManager calls it with std::vector< size_t >)
+  void communicate( std::vector< unsigned long long >& send_buffer,
+    std::vector< unsigned long long >& recv_buffer,
+    std::vector< int >& displacements );
+#endif
 
   void
   communicate( std::vector< int >& send_buffer, std::vector< int >& recv_buffer, std::vector< int >& displacements );
@@ -612,7 +622,12 @@ MPIManager::get_processor_name()
 {
   char name[ 1024 ];
   name[ 1023 ] = '\0';
+#ifdef _WIN32
+  unsigned long len = 1023;
+  GetComputerNameA( name, &len );
+#else
   gethostname( name, 1023 );
+#endif
   return name;
 }
 
diff --git a/nestkernel/random_manager.cpp b/nestkernel/random_manager.cpp
index d5549e6..cccd6e1 100644
--- a/nestkernel/random_manager.cpp
+++ b/nestkernel/random_manager.cpp
@@ -150,7 +150,12 @@ RandomManager::set_status( const Dictionary& d )
 
   if ( rng_seed_updated )
   {
+#ifdef _WIN32
+    // `long` is 32 bits: a seed in [2^31, 2^32) arrives as a negative long (the engine casts its unsigned seed) and the uint32 cast below restores it
+    if ( rng_seed == 0 )
+#else
     if ( not( 0 < rng_seed and rng_seed < ( 1L << 32 ) ) )
+#endif
     {
       throw BadProperty( "RNG seed must be in (0, 2^32-1)." );
     }
